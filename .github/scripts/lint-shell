#!/usr/bin/env bash
# ShellCheck every tracked shell script: files with a sh/bash shebang, or a
# "# shellcheck shell=" directive on their first line. Uses a local shellcheck
# when there is one, otherwise the koalaman/shellcheck image.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' f; do
  if head -n1 -- "$f" | grep -qE '^(#!.*\b(ba)?sh\b|# shellcheck shell=)'; then
    files+=("$f")
  fi
done < <(git ls-files -z)

echo "shellcheck: ${#files[@]} files"
if command -v shellcheck >/dev/null; then
  shellcheck -x "${files[@]}"
else
  docker run --rm -v "$PWD:/mnt:ro" -w /mnt koalaman/shellcheck:stable -x "${files[@]}"
fi
