#!/usr/bin/env bash
# Runtime smoke checks for the profile image. CI runs them on linux/amd64
# before it pushes. No tailnet login is involved.
# Usage: smoke-runtime IMAGE
set -uo pipefail

image=${1:?usage: smoke-runtime IMAGE}
failures=0

pass() { echo "PASS $*"; }
fail() {
  echo "FAIL $*"
  failures=$((failures + 1))
}

# retry N CMD...: run CMD once a second until it succeeds, at most N times.
retry() {
  local n=$1 i
  shift
  for ((i = 0; i < n; i++)); do
    "$@" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

# The image stops before the identity layer: each profile adds its own user.
check_identity() {
  local user env rc
  if ! user=$(docker image inspect --format '{{.Config.User}}' "$image") ||
    ! env=$(docker image inspect --format '{{json .Config.Env}}' "$image"); then
    fail "cannot inspect $image"
    return
  fi
  if [[ -z $user ]]; then pass "default user is root"; else fail "image sets USER=$user"; fi
  if [[ $env != *'"HOME='* ]]; then pass "HOME is not set"; else fail "image sets HOME: $env"; fi
  # getent exits 2 when the key is not found; any other status is a failure.
  docker run --rm "$image" getent passwd argus >/dev/null
  rc=$?
  case $rc in
    2) pass "no argus user" ;;
    0) fail "image has an argus user" ;;
    *) fail "getent passwd argus exited $rc" ;;
  esac
}

check_runtime_dirs() {
  local modes
  modes=$(docker run --rm "$image" stat -c '%a %n' /var/run/tailscale /opt/argus/share/supervisor)
  if [[ $modes == $'1777 /var/run/tailscale\n1777 /opt/argus/share/supervisor' ]]; then
    pass "runtime directories are 1777"
  else
    fail "runtime directory modes: $modes"
  fi
}

# The agent CLIs must not be able to replace themselves: the image's version
# is the one that runs.
check_cli_readonly() {
  local out
  if out=$(docker run --rm --user 12345:12345 "$image" sh -c '
      for p in /opt/argus/bin /opt/argus/lib/node_modules /opt/argus/bin/agy /opt/argus/bin/omp; do
        if [ -w "$p" ]; then echo "$p is writable"; exit 1; fi
      done
      owned=$(find /opt/argus/lib/node ! -uid 0 | head -n 1)
      if [ -n "$owned" ]; then echo "$owned is not owned by root"; exit 1; fi
      # Nothing under /opt/argus is group- or other-writable except the
      # supervisor runtime directory, which is 1777.
      loose=$(find /opt/argus -perm /022 ! -type l ! -path /opt/argus/share/supervisor | head -n 5)
      if [ -n "$loose" ]; then echo "group- or other-writable: $loose"; exit 1; fi
      grep -qx "check_for_update_on_startup = false" /etc/codex/config.toml || { echo "codex config missing"; exit 1; }' 2>&1); then
    pass "agent CLIs are read-only to a non-root user; codex update check is off"
  else
    fail "agent CLI install is not locked down: $out"
  fi
  # A process in group 0 cannot replace the pinned CLIs either.
  if out=$(docker run --rm --user 12345:0 "$image" sh -c '
      for p in /opt/argus /opt/argus/bin /opt/argus/share /opt/argus/bin/claude /opt/argus/bin/agy; do
        if [ -w "$p" ]; then echo "$p is writable"; exit 1; fi
      done' 2>&1); then
    pass "/opt/argus is read-only to a non-root user in group 0"
  else
    fail "/opt/argus is writable by group 0: $out"
  fi
}

check_update_env() {
  local env
  env=$(docker image inspect --format '{{json .Config.Env}}' "$image")
  if [[ $env == *'"DISABLE_AUTOUPDATER=1"'* && $env == *'"AGY_CLI_DISABLE_AUTO_UPDATE=true"'* ]]; then
    pass "claude and agy auto-updates are disabled in the image ENV"
  else
    fail "auto-update switches missing from image ENV: $env"
  fi
}

# supervisord as an arbitrary non-root UID over empty HOME and state
# directories, as a profile runs it.
check_supervisord() {
  local work cid out
  work=$(mktemp -d)
  mkdir -p "$work/home" "$work/ts"
  chmod 0777 "$work/home" "$work/ts"
  cid=$(docker run -d --user 12345:12345 -e HOME=/home/smoke \
    -v "$work/home:/home/smoke" -v "$work/ts:/var/lib/tailscale" \
    "$image" /usr/bin/supervisord -c /etc/supervisor/supervisord.conf)

  if retry 30 docker exec "$cid" sh -c 'test -f "$HOME/.zshrc" && test -L "$HOME/.oh-my-zsh"'; then
    pass "home-bootstrap seeded an empty HOME"
  else
    fail "home-bootstrap did not seed HOME"
    docker exec "$cid" cat /opt/argus/share/supervisor/home-bootstrap.log
  fi

  if retry 30 docker exec "$cid" bash -c 'exec 3<>/dev/tcp/localhost/1055'; then
    pass "tailscaled's proxy accepts connections on localhost:1055"
  else
    fail "nothing is listening on localhost:1055"
    docker exec "$cid" tail -n 30 /opt/argus/share/supervisor/tailscaled.log
  fi

  if out=$(docker exec "$cid" /opt/argus/bin/wait-proxy 2>&1) && [[ -z $out ]]; then
    pass "wait-proxy returns silently once the proxy is up"
  else
    fail "wait-proxy with the proxy up: $out"
  fi

  docker rm -f "$cid" >/dev/null
  # Files written by UID 12345 are not removable by the runner's user.
  docker run --rm -v "$work:/w" "$image" rm -rf /w/home /w/ts
  rmdir "$work"
}

check_wait_proxy_timeout() {
  local out
  if out=$(docker run --rm -e WAIT_PROXY_TIMEOUT=2 "$image" bash -c '
      start=$SECONDS
      /opt/argus/bin/wait-proxy 2>/tmp/err
      rc=$?
      elapsed=$((SECONDS - start))
      cat /tmp/err
      [ "$rc" -eq 0 ] && [ "$elapsed" -le 5 ] && grep -q "not accepting connections" /tmp/err' 2>&1); then
    pass "wait-proxy warns and returns 0 when tailscaled is down"
  else
    fail "wait-proxy without tailscaled: $out"
  fi
}

check_env_sh() {
  local got want image_env
  got=$(docker run --rm "$image" sh -c '. /opt/argus/etc/env.sh && env' | grep -iE '^(all|http|https|no)_proxy=' | sort)
  want=$(printf '%s\n' \
    ALL_PROXY=http://localhost:1055 all_proxy=http://localhost:1055 \
    HTTP_PROXY=http://localhost:1055 http_proxy=http://localhost:1055 \
    HTTPS_PROXY=http://localhost:1055 https_proxy=http://localhost:1055 \
    NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 | sort)
  if [[ $got == "$want" ]]; then pass "env.sh exports the proxy variables"; else fail "env.sh exports:"$'\n'"$got"; fi
  image_env=$(docker image inspect --format '{{json .Config.Env}}' "$image")
  if grep -qi proxy <<<"$image_env"; then
    fail "image ENV sets a proxy variable: $image_env"
  else
    pass "image ENV has no proxy variables"
  fi
}

# netguard in the configuration a profile runs it in: root, only NET_ADMIN,
# IPv6 disabled by sysctl. The prefixes span two lines, as a YAML block
# scalar in compose.yaml would pass them.
check_netguard() {
  local cid out
  cid=$(docker run -d --user root --cap-drop ALL --cap-add NET_ADMIN \
    --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    -e NETGUARD_TAILNET_PREFIXES=$'100.64.0.0/10,\n192.168.77.0/24' \
    --entrypoint /opt/argus/bin/netguard.sh "$image")
  if retry 20 docker exec "$cid" /opt/argus/bin/netguard.sh --check; then
    pass "netguard healthcheck passes"
  else
    fail "netguard healthcheck never passed"
    docker logs "$cid"
  fi
  out=$(docker exec "$cid" ip -4 route show type unreachable)
  if [[ $out == *"unreachable 100.64.0.0/10"* && $out == *"unreachable 192.168.77.0/24"* ]]; then
    pass "netguard routes every prefix to unreachable"
  else
    fail "netguard routes: $out"
  fi
  # iproute2 reports the unreachable route as EHOSTUNREACH, which prints
  # "No route to host" or "Host is unreachable" depending on the version.
  if out=$(docker exec "$cid" ip route get 100.79.1.1 2>&1); then
    fail "ip route get found a route: $out"
  elif [[ $out == *unreachable* || $out == *"No route to host"* ]]; then
    pass "tailnet address is unreachable"
  else
    fail "ip route get: $out"
  fi
  docker rm -f "$cid" >/dev/null
}

# expect_netguard_exit DESC DOCKER_RUN_ARGS...: netguard must exit nonzero,
# not sit running without a guard.
expect_netguard_exit() {
  local desc=$1 name=netguard-smoke-$RANDOM rc
  shift
  timeout 30 docker run --name "$name" "$@" --entrypoint /opt/argus/bin/netguard.sh "$image" >/dev/null 2>&1
  rc=$?
  docker rm -f "$name" >/dev/null 2>&1
  # 124 is the timeout; 125-127 are docker failing to run netguard at all.
  if ((rc != 0 && rc != 124 && (rc < 125 || rc > 127))); then
    pass "netguard exits nonzero $desc"
  else
    fail "netguard did not exit nonzero $desc (rc=$rc)"
  fi
}

check_netguard_fails_loudly() {
  expect_netguard_exit "without NET_ADMIN" \
    --user root --cap-drop ALL --sysctl net.ipv6.conf.all.disable_ipv6=1
  expect_netguard_exit "with IPv6 enabled" \
    --user root --cap-drop ALL --cap-add NET_ADMIN --sysctl net.ipv6.conf.all.disable_ipv6=0
  expect_netguard_exit "with a malformed prefix" \
    --user root --cap-drop ALL --cap-add NET_ADMIN --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    -e NETGUARD_TAILNET_PREFIXES=100.64.1.0/10
}

checks=(check_identity check_runtime_dirs check_cli_readonly check_update_env check_supervisord check_wait_proxy_timeout check_env_sh check_netguard check_netguard_fails_loudly)
for c in "${checks[@]}"; do "$c"; done

if ((failures)); then
  echo "$failures runtime check(s) failed"
  exit 1
fi
echo "all runtime checks passed"
