#!/usr/bin/env bash
# Runtime smoke checks for the profile image. CI runs them on each platform
# before it pushes. No tailnet login is involved.
# Usage: smoke-runtime IMAGE
set -uo pipefail

image=${1:?usage: smoke-runtime IMAGE}
failures=0

pass() { echo "PASS $*"; }
fail() {
  echo "FAIL $*"
  failures=$((failures + 1))
}

# retry N CMD...: run CMD once a second until it succeeds, at most N times.
retry() {
  local n=$1 i
  shift
  for ((i = 0; i < n; i++)); do
    "$@" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

# The image stops before the identity layer: each profile adds its own user.
check_identity() {
  local user env rc
  if ! user=$(docker image inspect --format '{{.Config.User}}' "$image") ||
    ! env=$(docker image inspect --format '{{json .Config.Env}}' "$image"); then
    fail "cannot inspect $image"
    return
  fi
  if [[ -z $user ]]; then pass "default user is root"; else fail "image sets USER=$user"; fi
  if [[ $env != *'"HOME='* ]]; then pass "HOME is not set"; else fail "image sets HOME: $env"; fi
  if [[ $env != *'"SHELL='* ]]; then pass "SHELL is not set"; else fail "image sets SHELL: $env"; fi
  # getent exits 2 when the key is not found; any other status is a failure.
  docker run --rm "$image" getent passwd argus >/dev/null
  rc=$?
  case $rc in
    2) pass "no argus user" ;;
    0) fail "image has an argus user" ;;
    *) fail "getent passwd argus exited $rc" ;;
  esac
}

check_runtime_dirs() {
  local mode out
  mode=$(docker run --rm "$image" stat -c '%a' /var/run/tailscale)
  if [[ $mode == 1777 ]]; then
    pass "/var/run/tailscale is 1777"
  else
    fail "/var/run/tailscale mode: $mode"
  fi
  # No profile user, even one in group 0, can replace a tool.
  if out=$(docker run --rm --user 12345:0 "$image" sh -c '
      for p in /opt/argus /opt/argus/bin /opt/argus/bin/netguard.sh /opt/argus/bin/tailscaled; do
        if [ -w "$p" ]; then echo "$p is writable"; exit 1; fi
      done
      loose=$(find /opt/argus -perm /022 ! -type l | head -n 5)
      if [ -n "$loose" ]; then echo "group- or other-writable: $loose"; exit 1; fi' 2>&1); then
    pass "/opt/argus is read-only to a non-root user in group 0"
  else
    fail "/opt/argus is writable by a non-root user: $out"
  fi
}

# Routing is native in the stack, so the agent needs no proxy settings.
check_no_agent_proxy() {
  local out image_env
  if out=$(docker run --rm "$image" sh -c '
      for f in /opt/argus/bin/wait-proxy /opt/argus/etc/env.sh; do
        if [ -e "$f" ]; then echo "$f exists"; exit 1; fi
      done' 2>&1); then
    pass "no wait-proxy or env.sh"
  else
    fail "agent proxy leftovers: $out"
  fi
  image_env=$(docker image inspect --format '{{json .Config.Env}}' "$image")
  if grep -qi proxy <<<"$image_env"; then
    fail "image ENV sets a proxy variable: $image_env"
  else
    pass "image ENV has no proxy variables"
  fi
}

# Raw-TCP and ICMP tools run in the stack. Docker's default
# net.ipv4.ping_group_range lets a non-root user ping without NET_RAW.
check_net_tools() {
  local out
  if out=$(docker run --rm --user 12345:12345 "$image" sh -c '
      for c in nc ping; do command -v "$c" >/dev/null || { echo "$c is missing"; exit 1; }; done
      ping -c 1 -W 2 127.0.0.1 >/dev/null' 2>&1); then
    pass "nc and ping are installed; ping works as a non-root user"
  else
    fail "network tools: $out"
  fi
}

# The e2e's target node runs this image and serves its nonce with perl, which
# perl-base, an Essential package, keeps in it.
check_perl_socket() {
  local out
  if out=$(docker run --rm --user 12345:12345 "$image" perl -MIO::Socket::INET -e1 2>&1); then
    pass "perl with IO::Socket::INET runs as a non-root user"
  else
    fail "perl with IO::Socket::INET, which the e2e target needs: $out"
  fi
}

# The agent service runs `sleep infinity` under `init: true` as the profile's
# user. tini as PID 1 reaps what `docker exec` leaves behind, which a bare
# `sleep` as PID 1 would leave as zombies.
check_agent_idle() {
  local cid out
  if ! cid=$(docker run -d --init --user 12345:12345 "$image" sleep infinity); then
    fail "cannot start sleep infinity under --init"
    return
  fi
  if out=$(docker exec "$cid" id -u 2>&1) && [[ $out == 12345 ]]; then
    pass "docker exec into the idle agent works as uid 12345"
  else
    fail "docker exec into the idle agent: $out"
  fi
  # The backgrounded sleep outlives its shell, so PID 1 inherits it.
  docker exec "$cid" sh -c 'sleep 1 &' >/dev/null 2>&1
  sleep 3
  if out=$(docker exec "$cid" ps -eo stat=,comm= 2>&1) && ! grep -q '^Z' <<<"$out"; then
    pass "PID 1 reaps orphaned exec children"
  else
    fail "zombies or no ps in the idle agent: $out"
  fi
  docker rm -f "$cid" >/dev/null
}

# Tools the image leaves out stay off PATH.
check_dropped() {
  local out
  if out=$(docker run --rm "$image" sh -c '
      found=""
      for c in claude codex omp agy node gcloud aws az pulumi kubectl helm k9s supervisord zsh git psql; do
        command -v "$c" >/dev/null && found="$found $c"
      done
      [ -z "$found" ] || { echo "on PATH:$found"; exit 1; }' 2>&1); then
    pass "no dropped tool is on PATH"
  else
    fail "dropped tools are back: $out"
  fi
}

# The image's uncompressed size, against a budget about 25% over the size it
# had when the budget was set: 224 MB on arm64 and 209 MB on amd64.
size_budget_mb=280
check_size() {
  local bytes mb
  if ! bytes=$(docker image inspect --format '{{.Size}}' "$image"); then
    fail "cannot inspect $image"
    return
  fi
  mb=$((bytes / 1000000))
  if ((mb <= size_budget_mb)); then
    pass "image is $mb MB, within the $size_budget_mb MB budget"
  else
    fail "image is $mb MB, over the $size_budget_mb MB budget"
  fi
}

# netguard_args: docker run arguments for netguard as a profile runs it: root,
# only NET_ADMIN, the TUN device, IPv6 disabled, the nftables firewall.
netguard_args=(--user root --cap-drop ALL --cap-add NET_ADMIN --device /dev/net/tun:/dev/net/tun
  --sysctl net.ipv6.conf.all.disable_ipv6=1 --sysctl net.ipv4.conf.all.src_valid_mark=1
  -e TS_DEBUG_FIREWALL_MODE=nftables)

# The TUN device is the Docker host's. Every netguard check needs it, so a
# host without it fails the suite rather than skipping them.
check_tun() {
  local out
  if out=$(docker run --rm --device /dev/net/tun:/dev/net/tun "$image" test -c /dev/net/tun 2>&1); then
    pass "the Docker host has /dev/net/tun"
  else
    fail "no usable /dev/net/tun on this Docker host; netguard's checks did not run: $out"
    return 1
  fi
}

# netguard in the configuration a profile runs it in, logged out. The
# prefixes span two lines, as a YAML block scalar in compose.yaml would pass
# them. The operator is a user the image has.
check_netguard() {
  local cid out port
  cid=$(docker run -d "${netguard_args[@]}" -p 127.0.0.1::1055 \
    -e NETGUARD_TAILNET_PREFIXES=$'100.64.0.0/10,\n192.168.77.0/24' \
    -e NETGUARD_TS_OPERATOR=nobody \
    --entrypoint /opt/argus/bin/netguard.sh "$image")
  if retry 20 docker exec "$cid" /opt/argus/bin/netguard.sh --check; then
    pass "netguard healthcheck passes"
  else
    fail "netguard healthcheck never passed"
    docker logs "$cid"
  fi
  out=$(docker exec "$cid" ip -4 route show type unreachable)
  if [[ $out == *"unreachable 100.64.0.0/10"* && $out == *"unreachable 192.168.77.0/24"* ]]; then
    pass "netguard routes every prefix to unreachable"
  else
    fail "netguard routes: $out"
  fi
  # iproute2 reports the unreachable route as EHOSTUNREACH, which prints
  # "No route to host" or "Host is unreachable" depending on the version.
  # tailscaled marks its own sockets with 0x80000, so check that path too.
  local mark
  for mark in "" "mark 0x80000"; do
    # shellcheck disable=SC2086 # $mark is two words or none
    if out=$(docker exec "$cid" ip route get 100.79.1.1 $mark 2>&1); then
      fail "ip route get 100.79.1.1 $mark found a route: $out"
    elif [[ $out == *unreachable* || $out == *"No route to host"* ]]; then
      pass "tailnet address is unreachable${mark:+ with $mark}"
    else
      fail "ip route get 100.79.1.1 $mark: $out"
    fi
  done

  out=$(docker exec "$cid" tailscale status --json 2>&1 | jq -r '.BackendState // empty' 2>&1)
  if [[ $out == NeedsLogin ]]; then
    pass "tailscaled answers on its socket (NeedsLogin)"
  else
    fail "tailscale status: $out"
  fi
  if docker exec "$cid" ip link show tailscale0 >/dev/null 2>&1; then
    pass "tailscaled runs in TUN mode (tailscale0 exists)"
  else
    fail "no tailscale0 device: $(docker exec "$cid" ip -br link 2>&1)"
  fi
  out=$(docker logs "$cid" 2>&1)
  if grep -q "netfilter running in nftables mode" <<<"$out"; then
    pass "tailscaled uses the nftables firewall"
  else
    fail "tailscaled is not in nftables mode: $(grep -iE 'netfilter|firewall|iptables' <<<"$out" | head -n 5)"
  fi
  if ! out=$(docker exec "$cid" tailscale status --json 2>&1) || ! out=$(jq -r '.Health[]?' <<<"$out" 2>&1); then
    fail "cannot read tailscaled's health: $out"
  elif grep -qiE 'firewall|netfilter|iptables|nftables' <<<"$out"; then
    fail "firewall health warnings: $out"
  else
    pass "no firewall health warnings"
  fi

  # The proxy must not listen on the tailnet address, so it listens only on
  # the bridge address Docker publishes.
  local addr
  addr=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$cid")
  out=$(docker exec "$cid" ss -ltnH 'sport = :1055' | awk '{ print $4 }' | sort -u)
  if [[ -n $addr && $out == "$addr:1055" ]]; then
    pass "tailscaled's proxy listens only on $addr:1055"
  else
    fail "tailscaled's proxy should listen only on ${addr:-the bridge address}:1055: $out"
  fi
  # Docker's port proxy accepts connections whatever listens behind it, so
  # complete a SOCKS5 greeting: no-auth offered, no-auth chosen.
  port=$(docker port "$cid" 1055/tcp | sed -n 's/^127\.0\.0\.1://p' | head -n 1)
  # shellcheck disable=SC2016 # $1 expands in the inner bash
  out=$(timeout 10 bash -c 'exec 3<>"/dev/tcp/127.0.0.1/$1" && printf "\x05\x01\x00" >&3 && head -c 2 <&3 | od -An -tx1' _ "${port:-0}" 2>&1)
  if [[ $(tr -d ' \n' <<<"$out") == 0500 ]]; then
    pass "the published port serves SOCKS5 to the host"
  else
    fail "the published port (${port:-none}) did not answer a SOCKS5 greeting: $out"
  fi

  if out=$(docker exec --user 65534:65534 "$cid" tailscale set --hostname=smoke-operator 2>&1); then
    pass "the operator can change tailscaled's settings"
  else
    fail "the operator cannot change settings: $out"
  fi
  expect_read_only "$cid" "other non-root users are read-only" 12345:12345

  # Each start gets a new namespace, so netguard must add the guard again.
  docker restart -t 2 "$cid" >/dev/null
  if retry 20 docker exec "$cid" /opt/argus/bin/netguard.sh --check; then
    pass "netguard restores the guard after a restart"
  else
    fail "netguard healthcheck never passed after a restart"
    docker logs --tail 20 "$cid"
  fi
  docker rm -f "$cid" >/dev/null
}

# expect_read_only CID DESC USER: USER can read tailscaled's status but is
# refused a settings change.
expect_read_only() {
  local out
  if ! out=$(docker exec --user "$3" "$1" tailscale status --json 2>&1); then
    fail "$2: status failed: $out"
  elif out=$(docker exec --user "$3" "$1" tailscale set --hostname=smoke-other 2>&1); then
    fail "$2: tailscale set succeeded"
  elif [[ $out == *"Access denied"* ]]; then
    pass "$2"
  else
    fail "$2: tailscale set failed for another reason: $out"
  fi
}

# expect_unhealthy CID DESC: netguard's healthcheck keeps failing.
expect_unhealthy() {
  local i
  for i in 1 2 3 4 5 6 7 8; do
    if docker exec "$1" /opt/argus/bin/netguard.sh --check >/dev/null 2>&1; then
      fail "$2: the healthcheck passed"
      return
    fi
    sleep 1
  done
  pass "$2"
}

# The healthcheck covers the operator: a name that resolves to no user, or an
# operator changed after start, leaves the agent read-only, so the stack must
# not count as healthy. tailscaled itself accepts any name.
check_netguard_operator_health() {
  local cid
  cid=$(docker run -d "${netguard_args[@]}" -e NETGUARD_TS_OPERATOR=no-such-user \
    --entrypoint /opt/argus/bin/netguard.sh "$image")
  expect_unhealthy "$cid" "netguard is unhealthy when the operator is not a user"
  docker rm -f "$cid" >/dev/null

  cid=$(docker run -d "${netguard_args[@]}" -e NETGUARD_TS_OPERATOR=nobody \
    --entrypoint /opt/argus/bin/netguard.sh "$image")
  if retry 20 docker exec "$cid" /opt/argus/bin/netguard.sh --check; then
    docker exec "$cid" tailscale set --operator= >/dev/null
    expect_unhealthy "$cid" "netguard is unhealthy when the operator is cleared"
  else
    fail "netguard with operator nobody never became healthy"
    docker logs --tail 20 "$cid"
  fi
  docker rm -f "$cid" >/dev/null
}

# Without NETGUARD_TS_OPERATOR, netguard starts and sets no operator.
check_netguard_no_operator() {
  local cid out
  cid=$(docker run -d "${netguard_args[@]}" --entrypoint /opt/argus/bin/netguard.sh "$image")
  if retry 20 docker exec "$cid" /opt/argus/bin/netguard.sh --check; then
    pass "netguard starts without an operator"
  else
    fail "netguard without an operator never became healthy"
    docker logs --tail 20 "$cid"
  fi
  expect_read_only "$cid" "with no operator, non-root users are read-only" 65534:65534
  docker rm -f "$cid" >/dev/null
}

# expect_netguard_exit DESC DOCKER_RUN_ARGS...: netguard must exit nonzero,
# not sit running without a guard.
expect_netguard_exit() {
  local desc=$1 name=netguard-smoke-$RANDOM rc
  shift
  timeout 30 docker run --name "$name" "$@" --entrypoint /opt/argus/bin/netguard.sh "$image" >/dev/null 2>&1
  rc=$?
  docker rm -f "$name" >/dev/null 2>&1
  # 124 is the timeout; 125-127 are docker failing to run netguard at all.
  if ((rc != 0 && rc != 124 && (rc < 125 || rc > 127))); then
    pass "netguard exits nonzero $desc"
  else
    fail "netguard did not exit nonzero $desc (rc=$rc)"
  fi
}

check_netguard_fails_loudly() {
  local tun=(--device /dev/net/tun:/dev/net/tun --sysctl net.ipv4.conf.all.src_valid_mark=1)
  expect_netguard_exit "without NET_ADMIN" \
    --user root --cap-drop ALL "${tun[@]}" --sysctl net.ipv6.conf.all.disable_ipv6=1
  expect_netguard_exit "with IPv6 enabled" \
    --user root --cap-drop ALL --cap-add NET_ADMIN "${tun[@]}" --sysctl net.ipv6.conf.all.disable_ipv6=0
  expect_netguard_exit "with a malformed prefix" \
    --user root --cap-drop ALL --cap-add NET_ADMIN "${tun[@]}" --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    -e NETGUARD_TAILNET_PREFIXES=100.64.1.0/10
  expect_netguard_exit "without /dev/net/tun" \
    --user root --cap-drop ALL --cap-add NET_ADMIN --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    --sysctl net.ipv4.conf.all.src_valid_mark=1
  # A state directory another user owns is unwritable to a root without
  # DAC_OVERRIDE, and tailscaled would fall back to an in-memory store.
  # volume-nocopy keeps Docker from copying the image's root-owned directory
  # over the volume's ownership.
  local vol=netguard-smoke-state-$RANDOM
  docker run --rm -v "$vol:/s" "$image" sh -c 'chown 12345:12345 /s && chmod 0700 /s'
  expect_netguard_exit "with a state directory it cannot write" \
    --user root --cap-drop ALL --cap-add NET_ADMIN "${tun[@]}" --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    --mount "type=volume,src=$vol,dst=/var/lib/tailscale,volume-nocopy"
  docker volume rm -f "$vol" >/dev/null
}

checks=(check_identity check_runtime_dirs check_no_agent_proxy check_net_tools check_perl_socket check_agent_idle
  check_dropped check_size)
if check_tun; then
  checks+=(check_netguard check_netguard_no_operator check_netguard_operator_health check_netguard_fails_loudly)
fi
for c in "${checks[@]}"; do "$c"; done

if ((failures)); then
  echo "$failures runtime check(s) failed"
  exit 1
fi
echo "all runtime checks passed"
